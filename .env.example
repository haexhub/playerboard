# Supabase — values printed by `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Server-only. @nuxtjs/supabase's serverSupabaseServiceRole() (used to send
# invite mails via signInWithOtp) only reads NUXT_SUPABASE_SECRET_KEY at
# runtime — mirrors SUPABASE_SERVICE_KEY above.
NUXT_SUPABASE_SECRET_KEY=

# Postgres connection for Drizzle (server-side). Local default from `supabase status`.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NUXT_SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Veo camera analytics (specs/003-veo-analytics). Shared secret the
# production cron sends as `Authorization: Bearer ...` to POST /api/veo/sync.
# Never the club's Veo password/session — that lives in veo_sync_credentials.
NUXT_VEO_SYNC_SECRET=
# Encrypts and signs the short-lived token between POST /api/veo/login and POST
# /api/veo/link (carries an encrypted, freshly captured session cookie;
# the trainer's password never reaches this flow's storage). Generate a
# high-entropy secret, keep it confidential, and use it to sign the link token.
NUXT_VEO_LINK_TOKEN_SECRET=
